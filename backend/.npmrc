# @circle-fin/adapter-solana-kit declares a peer dependency on
# @solana/kit@^5.0.0, but this project runs ^7.0.0 (used throughout the
# existing Solana deposit/withdraw code). Independently verified
# (2026-08-19) that every symbol the adapter actually imports from
# @solana/kit exists and type-checks cleanly against the installed v7 —
# the peer range is very likely just conservative/stale, not a real
# incompatibility. Without this setting, `npm install` fails with an
# ERESOLVE conflict on that one declared (but not actually exercised)
# version mismatch.
legacy-peer-deps=true
