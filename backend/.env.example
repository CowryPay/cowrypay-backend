# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated allowlist for browser callers (your frontend's origin).
# Unset = allow any origin — fine before you have a real frontend URL to
# lock down to, since auth is bearer-token based (no cookies, no CSRF risk).
CORS_ORIGINS=

# ── Database (Supabase Postgres) ────────────────────────────────────────────────
# Project Settings → Database → Connection string (URI). Use the "Session"
# pooler connection for a long-running server like this one.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
# Supabase requires SSL; leave this unset (or true) except for a local Postgres.
DATABASE_SSL=true

# ── Auth (Supabase Auth — email OTP) ──────────────────────────────────────────────
# Project Settings → API → Project URL. Used to fetch Supabase's public JWKS
# and verify tokens the client already obtained from Supabase Auth — this
# backend never sends or checks OTP codes itself.
SUPABASE_URL=https://your-project-ref.supabase.co

# ── Wallet infra ─────────────────────────────────────────────────────────────────
# "mock" generates a fake deposit address locally — no external calls.
# Set to "blockradar" to use the real adapter (needs the vars below too).
WALLET_PROVIDER=mock
DEFAULT_CHAIN=mock-chain
DEFAULT_TOKEN_SYMBOL=USDC

# Only needed when WALLET_PROVIDER=blockradar.
# dashboard.blockradar.co/wallets → create a master wallet for your chosen
# chain first, then: API key = wallet's x-api-key, wallet id = its id.
# Also set the webhook URL on that same wallet (Developers tab) to:
#   https://<your-public-host>/webhooks/blockradar
BLOCKRADAR_API_KEY=
BLOCKRADAR_WALLET_ID=
BLOCKRADAR_BASE_URL=https://api.blockradar.co/v1

# ── Deposit compliance screening (mock) ───────────────────────────────────────────
# Deposits at/above this amount are routed to MANUAL_REVIEW instead of
# auto-crediting — lets the manual-review branch be exercised before a real
# AML/sanctions vendor is wired in.
MOCK_SCREENING_FLAG_THRESHOLD=5000

# ── KYC ───────────────────────────────────────────────────────────────────────
# "mock" resolves verification via POST /webhooks/kyc instead of a real
# vendor. Swap to a real provider (Smile ID / Youverify / Dojah) once that
# adapter is implemented.
KYC_PROVIDER=mock

# ── Chat agent (Groq, OpenAI-compatible) ──────────────────────────────────────────
# Only used for the free-form fallback in POST /chat and intent parsing —
# balance/address/help are answered deterministically without this. Unset
# means that fallback degrades to a static reply instead of erroring.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback only — used when Groq is unavailable/errors. Unset means no
# fallback; Groq failures degrade to the static reply, same as before.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Off-ramp provider (Paycrest) ──────────────────────────────────────────────────
# app.paycrest.io → complete KYB verification to get these. Rate quotes
# (GET /offramp/rate) are public and need neither.
PAYCREST_API_KEY=
PAYCREST_API_SECRET=
PAYCREST_BASE_URL=https://api.paycrest.io/v2

# ── Chat session state ────────────────────────────────────────────────────────────
# A half-finished multi-turn draft (e.g. a partial send request) expires
# after this many minutes of no reply — the next message starts fresh.
CHAT_SESSION_IDLE_MINUTES=10

# ── Remittance platform fee ───────────────────────────────────────────────────────
# Skimmed from every send, in basis points (100 = 1%). Only the net amount
# (after fee) is sent to Paycrest for conversion — the fee itself is swept
# on-chain to this treasury address right after the payout.
REMITTANCE_TREASURY_ADDRESS=
REMITTANCE_FEE_BPS=100

# ── Saved recipients ──────────────────────────────────────────────────────────────
# Any secret string — a 32-byte AES key is derived from it via scrypt, so it
# doesn't need to be exact raw key bytes. Used to encrypt saved recipients'
# account numbers/phone numbers at rest.
RECIPIENT_ENCRYPTION_KEY=

# ── Admin endpoints ────────────────────────────────────────────────────────────────
# No role/permission system exists yet — POST /admin/deposits/:id/review is
# gated by this shared secret (sent as the x-admin-key header) instead of
# real per-admin auth.
ADMIN_API_KEY=

# ── Self-custody wallet migration, Phase 1+2 (AWS KMS) — staging branch only ──────
# Only needed when WALLET_PROVIDER=aws-kms (never set on Railway/production
# today). IAM user needs kms:CreateKey, kms:CreateAlias, kms:TagResource,
# kms:GetPublicKey, kms:Sign, kms:DescribeKey, kms:ScheduleKeyDeletion.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The single KMS key every withdraw() call signs with (Celo/USDC only for
# now) — mirrors BLOCKRADAR_WALLET_ID being one fixed master wallet today.
AWS_KMS_PAYOUT_KEY_ARN=
CELO_RPC_URL=https://forno.celo.org
