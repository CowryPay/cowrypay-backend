# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
# Comma-separated allowlist for browser callers (your frontend's origin).
# Unset = allow any origin — fine before you have a real frontend URL to
# lock down to, since auth is bearer-token based (no cookies, no CSRF risk).
CORS_ORIGINS=

# ── Database (Supabase Postgres) ────────────────────────────────────────────────
# Project Settings → Database → Connection string (URI). Use the "Session"
# pooler connection for a long-running server like this one.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
# Supabase requires SSL; leave this unset (or true) except for a local Postgres.
DATABASE_SSL=true

# ── Auth (Supabase Auth — email OTP) ──────────────────────────────────────────────
# Project Settings → API → Project URL. Used to fetch Supabase's public JWKS
# and verify tokens the client already obtained from Supabase Auth — this
# backend never sends or checks OTP codes itself.
SUPABASE_URL=https://your-project-ref.supabase.co

# ── Wallet infra ─────────────────────────────────────────────────────────────────
# "mock" generates a fake deposit address locally — no external calls.
# Set to "blockradar" to use the real adapter (needs the vars below too).
WALLET_PROVIDER=mock
DEFAULT_CHAIN=mock-chain
DEFAULT_TOKEN_SYMBOL=USDC

# Only needed when WALLET_PROVIDER=blockradar.
# dashboard.blockradar.co/wallets → create a master wallet for your chosen
# chain first, then: API key = wallet's x-api-key, wallet id = its id.
# Also set the webhook URL on that same wallet (Developers tab) to:
#   https://<your-public-host>/webhooks/blockradar
BLOCKRADAR_API_KEY=
BLOCKRADAR_WALLET_ID=
BLOCKRADAR_BASE_URL=https://api.blockradar.co/v1

# ── Deposit compliance screening (mock) ───────────────────────────────────────────
# Deposits at/above this amount are routed to MANUAL_REVIEW instead of
# auto-crediting — lets the manual-review branch be exercised before a real
# AML/sanctions vendor is wired in.
MOCK_SCREENING_FLAG_THRESHOLD=5000

# ── KYC ───────────────────────────────────────────────────────────────────────
# "mock" resolves verification via POST /webhooks/kyc instead of a real
# vendor. Set to "dojah" to use Dojah EasyOnboard (needs DOJAH_SECRET_KEY).
KYC_PROVIDER=mock
# Dojah EasyOnboard, Widget SDK launch — the frontend has a real screen to
# mount it in. From Dojah's dashboard (Settings > API) once a sandbox app
# exists: appId + publicKey go to the frontend to render the widget;
# secretKey stays server-side, sent as the Authorization header on OUTBOUND
# calls we make to Dojah (AML screening). widgetId identifies the specific
# EasyOnboard flow (document types per country, liveness/selfie-match)
# configured in their visual editor — the widget can't launch without one.
DOJAH_APP_ID=
DOJAH_PUBLIC_KEY=
DOJAH_SECRET_KEY=
# The Nigeria/Kenya EasyOnboard workflow (includes the Government Data
# step — BVN/NIN/National ID live registry lookup). Confirmed live with
# Dojah (2026-09-22/23) that this step ONLY exists for those two
# countries, and a workflow's steps can't be made conditional — every
# other country needs the separate workflow below instead.
DOJAH_WIDGET_ID=
# The Government-Issued-ID-only workflow (document OCR, no Government
# Data step) — used for every country besides Nigeria/Kenya, since that
# check works globally. A second EasyOnboard workflow, created separately
# in Dojah's dashboard.
DOJAH_WIDGET_ID_GLOBAL=
DOJAH_BASE_URL=https://api.dojah.io
# A DIFFERENT secret from DOJAH_SECRET_KEY above — confirmed live
# (2026-09-16), a real webhook delivery 401'd when checked against the API
# secret key. This is the per-subscription secret shown on Dojah's
# Developers > Webhooks page, used ONLY to verify an INBOUND webhook's
# x-dojah-signature. Falls back to DOJAH_SECRET_KEY if unset — set this
# explicitly to the webhook subscription's own secret, not the API one.
DOJAH_WEBHOOK_SECRET=

# How long (minutes) a "pending" KYC attempt is treated as still-open —
# vendor-agnostic, not Dojah-specific. Within this window, retrying
# POST /kyc/start reuses the existing attempt instead of minting (and
# billing) a new one; past it, both that retry path and a background
# poller auto-abandon the stale attempt, reverting the user to
# "unverified" instead of leaving them stuck "pending" forever.
KYC_PENDING_TTL_MINUTES=30

# AML/watchlist screening, run when KYC completes (needs DOJAH_APP_ID +
# DOJAH_SECRET_KEY). Off unless "true" — each screen is a billed Dojah call,
# and flagged users are held (kyc_status stays pending) for admin review.
AML_SCREENING_ENABLED=false
AML_MATCH_THRESHOLD=0.85

# AML screening of remittance RECIPIENTS (not the sender) — separate flag
# from AML_SCREENING_ENABLED above so each can roll out independently.
# Cached per recipient identity (fingerprint), so a repeat send to an
# already-screened recipient doesn't re-bill Dojah.
AML_RECIPIENT_SCREENING_ENABLED=false

# ── Chat agent (Groq, OpenAI-compatible) ──────────────────────────────────────────
# Only used for the free-form fallback in POST /chat and intent parsing —
# balance/address/help are answered deterministically without this. Unset
# means that fallback degrades to a static reply instead of erroring.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback only — used when Groq is unavailable/errors. Unset means no
# fallback; Groq failures degrade to the static reply, same as before.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Off-ramp provider (Paycrest) ──────────────────────────────────────────────────
# app.paycrest.io → complete KYB verification to get these. Rate quotes
# (GET /offramp/rate) are public and need neither.
PAYCREST_API_KEY=
PAYCREST_API_SECRET=
PAYCREST_BASE_URL=https://api.paycrest.io/v2

# ── Chat session state ────────────────────────────────────────────────────────────
# A half-finished multi-turn draft (e.g. a partial send request) expires
# after this many minutes of no reply — the next message starts fresh.
CHAT_SESSION_IDLE_MINUTES=10

# ── Remittance platform fee ───────────────────────────────────────────────────────
# Skimmed from every send, in basis points (100 = 1%). Only the net amount
# (after fee) is sent to Paycrest for conversion — the fee itself is swept
# on-chain to this treasury address right after the payout.
REMITTANCE_TREASURY_ADDRESS=
REMITTANCE_FEE_BPS=100

# ── Saved recipients ──────────────────────────────────────────────────────────────
# Any secret string — a 32-byte AES key is derived from it via scrypt, so it
# doesn't need to be exact raw key bytes. Used to encrypt saved recipients'
# account numbers/phone numbers at rest.
RECIPIENT_ENCRYPTION_KEY=

# ── Admin endpoints ────────────────────────────────────────────────────────────────
# No role/permission system exists yet — POST /admin/deposits/:id/review is
# gated by this shared secret (sent as the x-admin-key header) instead of
# real per-admin auth.
ADMIN_API_KEY=

# ── Self-custody wallet migration, Phase 1+2 (AWS KMS) — staging branch only ──────
# Only needed when WALLET_PROVIDER=aws-kms (never set on Railway/production
# today). IAM user needs kms:CreateKey, kms:CreateAlias, kms:TagResource,
# kms:GetPublicKey, kms:Sign, kms:DescribeKey, kms:ScheduleKeyDeletion.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The single KMS key every withdraw() call signs with (Celo/USDC only for
# now) — mirrors BLOCKRADAR_WALLET_ID being one fixed master wallet today.
AWS_KMS_PAYOUT_KEY_ARN=
CELO_RPC_URL=https://forno.celo.org

# EVM deposit speed layer (Alchemy address-activity webhooks) — a
# near-instant path alongside the existing 30s poller (depositScanner.ts),
# never a replacement for it. Everything here is UNVERIFIED against a real
# live Alchemy account — see scripts/verify-alchemy-notify-api.ts. Unset
# entries simply mean that chain is never watched/registered/reconciled.
ALCHEMY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_ID_CELO=
ALCHEMY_WEBHOOK_SIGNING_KEY_CELO=
ALCHEMY_WEBHOOK_ID_BASE=
ALCHEMY_WEBHOOK_SIGNING_KEY_BASE=
ALCHEMY_WEBHOOK_ID_OPTIMISM=
ALCHEMY_WEBHOOK_SIGNING_KEY_OPTIMISM=
ALCHEMY_WEBHOOK_ID_ETHEREUM=
ALCHEMY_WEBHOOK_SIGNING_KEY_ETHEREUM=
ALCHEMY_WEBHOOK_ID_ARC=
ALCHEMY_WEBHOOK_SIGNING_KEY_ARC=
EVM_WEBHOOK_DEPOSITS_ENABLED=false
